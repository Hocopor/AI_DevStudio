# ============================================================
# AI DevStudio - Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to git.
# ============================================================

# --- Domain / Tunnel ---
# Public domain that will be attached to this stack through Cloudflare Tunnel.
DOMAIN=ai-devstudio.mak-o.ru

# Cloudflare Tunnel token for this exact project.
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN

# Internal docker service URLs used by the infrastructure of this project.
# Normally you do not change them.
INTERNAL_WEB_URL=http://devstudio-web
INTERNAL_APP_URL=http://devstudio-app:8000

# --- Authentication ---
ADMIN_LOGIN=admin

# Escape every "$" in bcrypt hashes as "$$" for Docker Compose.
# Example raw bcrypt hash:
# $2b$12$abc...
# Example value in .env:
# $$2b$$12$$abc...
ADMIN_PASSWORD_HASH=$$2b$$12$$REPLACE_WITH_REAL_HASH

JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING
JWT_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30

# --- Database ---
POSTGRES_DB=devstudio
POSTGRES_USER=devstudio
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://devstudio:REPLACE_WITH_STRONG_POSTGRES_PASSWORD@postgres:5432/devstudio

# --- Redis ---
# Use one strong password for the Redis container.
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# Main app Redis DB.
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/0

# Celery uses the same Redis password, but separate logical DBs.
CELERY_BROKER_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/2

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_MINIO_PASSWORD
MINIO_ENDPOINT=minio:9000

# --- AI Providers ---
DEEPSEEK_API_KEY=sk-REPLACE
GOOGLE_AI_STUDIO_KEY=AIza-REPLACE

# --- VK Notifications ---
# Community access token with permission to work with messages.
VK_API_TOKEN=vk1.a.REPLACE

# Personal VK user id that will receive notifications from the community.
VK_OWNER_USER_ID=000000000

# VK community id.
VK_GROUP_ID=000000000

# --- Application ---
ENVIRONMENT=production
SECRET_KEY=REPLACE_WITH_ANOTHER_RANDOM_64_CHAR_STRING
