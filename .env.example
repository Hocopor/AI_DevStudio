# ============================================================
# AI DevStudio — Environment Variables
# Скопируй в .env и заполни реальными значениями
# НИКОГДА не коммить .env в git
# ============================================================

# --- Домен ---
DOMAIN=ai-devstudio.mak-o.ru

# --- Аутентификация ---
# Логин для входа в панель
ADMIN_LOGIN=admin
# Хэш пароля bcrypt. Генерация:
# python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_REAL_HASH

# JWT
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING
JWT_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30

# --- База данных ---
POSTGRES_DB=devstudio
POSTGRES_USER=devstudio
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://devstudio:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/devstudio

# --- Redis ---
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_PASSWORD@redis:6379/0

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MINIO_ENDPOINT=minio:9000

# --- AI Провайдеры ---
# DeepSeek
DEEPSEEK_API_KEY=sk-REPLACE

# Google AI Studio
GOOGLE_AI_STUDIO_KEY=AIza-REPLACE

# Codex OAuth — аккаунты управляются через веб-панель, хранятся в БД зашифрованно

# --- VK ---
# Токен группы (Управление → Работа с API → Создать ключ → Сообщения)
VK_API_TOKEN=vk1.a.REPLACE
# ID владельца (твой личный user_id в VK)
VK_OWNER_USER_ID=000000000
# ID группы
VK_GROUP_ID=000000000

# --- Приложение ---
ENVIRONMENT=production
SECRET_KEY=REPLACE_WITH_ANOTHER_RANDOM_64_CHAR_STRING

# --- Celery ---
CELERY_BROKER_URL=redis://:REPLACE_WITH_STRONG_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_STRONG_PASSWORD@redis:6379/2
